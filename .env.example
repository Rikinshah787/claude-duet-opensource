# =============================================================================
# Claude Duet - environment template
#
#   cp .env.example .env
#
# Every application setting is a field on `Settings` in apps/api/duet/config.py
# and is read with the `DUET_` prefix. Unknown DUET_* vars are ignored, so the
# reserved entries below are safe to leave in place.
#
# Two consumers read this file:
#   * docker compose  - reads ./.env from the repo root automatically.
#   * bare-metal dev  - pydantic-settings reads `.env` relative to the process
#                       working directory, which is apps/api for uvicorn. Copy
#                       this file to apps/api/.env too if you run without Docker
#                       and want more than the built-in defaults.
#
# Everything here has a working default. The one value you MUST change is
# DUET_SECRET_KEY (see the security section).
# =============================================================================


# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------

# Display name shown in the UI and the morning brief.
DUET_APP_NAME=Claude Duet (local)

# local | docker | staging | production. Only used for labelling and log context.
DUET_ENVIRONMENT=local

# Verbose logging + FastAPI docs at /docs. Turn off for anything shared.
DUET_DEBUG=true

# Where the SQLite file, WAL sidecars and the encrypted credential vault live.
# Read directly from the process environment at import time (not a Settings field),
# so it must be set before the API starts. Default: apps/api/.data
#
# Left commented on purpose: config.py does os.environ.get("DUET_DATA_DIR", ...),
# so an *empty* value is not the same as unset - it resolves to "." and the data
# dir becomes whatever the working directory happens to be. Set it or omit it.
# DUET_DATA_DIR=/absolute/path/to/duet-data


# -----------------------------------------------------------------------------
# DATABASE / CACHE / VECTORS
# -----------------------------------------------------------------------------

# Unset = SQLite at ${DUET_DATA_DIR}/duet.db (the local-first default).
#
# Commented, not blank: `DUET_DATABASE_URL=` would hand pydantic-settings an
# empty string, which overrides the SQLite default and breaks create_engine().
# Uncomment only when you actually want Postgres.
# DUET_DATABASE_URL=postgresql+psycopg://duet:duet@localhost:5432/duet

# Optional. Unset = in-process event bus, fine for a single API process.
# Set it when you run more than one worker.
# DUET_REDIS_URL=redis://localhost:6379/0

# Reserved for the vector/recall layer. Unset = semantic recall disabled.
# DUET_QDRANT_URL=http://localhost:6333
# DUET_QDRANT_COLLECTION=duet_memory

# --- docker compose only (not read by the API) ---
POSTGRES_USER=duet
POSTGRES_PASSWORD=duet
POSTGRES_DB=duet
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333


# -----------------------------------------------------------------------------
# MODEL LAYER
# -----------------------------------------------------------------------------

# ollama | openai | heuristic
# `heuristic` is a deterministic offline planner: the product runs end to end
# with no model installed and no API key. Start here.
# Leave this commented out unless you want to force a specific backend.
# Uncommenting with a value OVERRIDES auto-detection - that is how a
# template can silently pin you to the offline planner.
#   auto (default) | agent_cli | anthropic | ollama | openai | heuristic
# DUET_LLM_PROVIDER=auto

# Which agent CLI to use when several are installed. Naming one you do not
# have fails loudly rather than quietly substituting another.
#   auto (default) | claude | codex | gemini | cursor | opencode
# DUET_LLM_CLI=auto

# Base URL of the inference server. Ollama default shown; inside compose with the
# local-llm profile use http://ollama:11434.
# DUET_LLM_BASE_URL=http://localhost:11434

# Model tag passed to the provider. Ignored when provider=heuristic.
# Empty means "whatever that backend's own default is", which is usually
# right - a model name valid for one vendor is invalid for another.
# DUET_LLM_MODEL=

# Only needed for provider=openai. Harmless when blank (the field is optional).
DUET_LLM_API_KEY=

# Seconds to wait for a completion. Local 7B models on CPU are slow - keep it high.
DUET_LLM_TIMEOUT_S=120

# Sampling temperature. Low, because planner output is parsed, not read.
DUET_LLM_TEMPERATURE=0.2


# -----------------------------------------------------------------------------
# AUTONOMY
# -----------------------------------------------------------------------------

# Seconds between connector sweeps by the monitor loop. 900 = 15 minutes.
# Each sweep costs model turns, so raise this rather than lower it.
DUET_SWEEP_INTERVAL_S=900

# Local hour (0-23) the morning brief is generated.
DUET_BRIEFING_HOUR=7

# How many agent tasks may run concurrently.
DUET_MAX_PARALLEL_TASKS=4

# Attempts per task before it is parked as failed.
DUET_TASK_RETRY_LIMIT=3


# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# !!! CHANGE THIS BEFORE FIRST RUN !!!
#
# DUET_SECRET_KEY is the master key for the encrypted credential vault
# (vault.enc) - every connector token and password you give Duet is encrypted
# with it. Consequences:
#   * Lose or change this key and the existing vault CANNOT be decrypted. There
#     is no recovery path; you re-enter every credential.
#   * Back it up somewhere separate from the vault file itself.
#   * Never commit it, and never reuse the dev default outside your own machine.
#
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DUET_SECRET_KEY=dev-only-insecure-key-change-me

# Minutes a standing approval grant stays valid. 720 = 12 hours.
DUET_APPROVAL_EXPIRY_MINUTES=720

# Redact tokens, emails and other sensitive strings from logs and traces.
# Leave on unless you are actively debugging a connector payload.
# (removed) There is deliberately no switch to disable redaction. Audit
# scrubbing and the sensitive-information classifier are unconditional.


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Bind address. 127.0.0.1 keeps the API off your LAN; containers must use 0.0.0.0.
DUET_HOST=127.0.0.1

# API port. Also the port scripts/dev.ps1 and the Makefile poll for health.
DUET_PORT=8787

# Comma-separated browser origins allowed to call the API.
DUET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- web / compose only (not read by the API) ---
# Base URL the browser uses to reach the API. Baked in at Next.js build time.
NEXT_PUBLIC_API_BASE=http://localhost:8787
WEB_PORT=3000

# Optional local model server (docker compose --profile local-llm).
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m

# -----------------------------------------------------------------------------
# Autonomy
# -----------------------------------------------------------------------------
# How much happens without asking you.
#   proportional (default) - safe AND reversible actions (drafts, notes,
#                            internal records) just happen and are reported
#                            afterwards; anything that reaches a person, moves
#                            money, changes access or deletes still waits.
#   ask_everything         - nothing at all happens without an explicit approval.
# Two actions are refused under both settings, with or without your consent:
# moving money between accounts, and trading securities.
# DUET_AUTONOMY=proportional

# Execution sandbox for generated code: subprocess | docker.
# subprocess is process isolation, NOT a security boundary - use docker for
# anything you did not write yourself.
# DUET_SANDBOX_BACKEND=subprocess
